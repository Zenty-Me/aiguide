---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';

interface Props {
  title: string;
  description: string;
  image?: string;
  type?: 'website' | 'article';
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  /** Page URL override; false omits the tag (used by 404). */
  canonical?: string | false;
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description,
  image = SITE.ogImage,
  type = 'website',
  jsonLd = [],
  noindex = false,
  canonical: canonicalOverride,
  publishedTime,
  modifiedTime,
} = Astro.props;

const documentTitle = title === SITE.title ? title : `${title} · ${SITE.name}`;
const canonical =
  canonicalOverride === false
    ? null
    : canonicalOverride ?? new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL(image, Astro.site).href;
const schema = [...jsonLd];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{documentTitle}</title>
    <meta name="description" content={description} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta
      name="robots"
      content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}
    />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#faf9f6" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <link rel="preload" href="/fonts/host-grotesk-latin.woff2" as="font" type="font/woff2" crossorigin />

    <script is:inline>
      document.documentElement.classList.add('m-enter');
    </script>
    <script is:inline>
      (function () {
        try {
          var stored = localStorage.getItem('zenty-theme');
          var dark =
            stored === 'dark' ||
            (stored !== 'light' &&
              window.matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
          var meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.setAttribute('content', dark ? '#14130f' : '#faf9f6');
        } catch (error) {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={documentTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.name} — ${SITE.description}`} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={documentTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    {
      schema.map((item) => (
        <script type="application/ld+json" set:html={JSON.stringify(item)} />
      ))
    }
  </head>
  <body>
    <a class="skip-link" href="#main">跳到正文</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <div id="copy-status" class="sr-only" role="status" aria-live="polite"></div>
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>