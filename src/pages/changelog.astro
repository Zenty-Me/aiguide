---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { breadcrumbJsonLd } from '../lib/seo';

const crumbs = [{ label: '首页', href: '/' }, { label: '更新日志' }];

const entries = [
  {
    date: '2026-11-14',
    label: '教程扩充：六个主题路线',
    items: [
      '教程扩充到 36 篇，覆盖 Codex、Claude Code、MCP、Skills、Agent 与自动化六个主题，每个主题都有一条从入门到协作的完整顺序。',
      '学习路线拆成六条，补齐安装登录、Windows 环境、权限控制、排错、子代理与评估等步骤；Windows 作为可选环境分支，不影响主线阅读。',
      '首页只预览每条路线的前三步，完整步骤放在学习路线页，想按顺序读时不用来回翻找。',
      '上一篇与下一篇改为在同一主题内衔接，读完 Codex 不会再跳到 Claude Code。',
      '搜索、RSS 与站点地图覆盖全部教程，新增内容同样可以站内检索和订阅。',
    ],
  },
  {
    date: '2026-11-14',
    label: 'SEO 与内容质量修订',
    items: [
      '教程页标注最近修订日期，便于判断内容是否仍然适用。',
      '文章署名改为可点击的作者入口，关于页说明维护者与编辑原则。',
      '重写 12 篇教程的标题与部分描述，标题更贴近要解决的具体问题。',
      'Codex 入门新增按失败现象排查的顺序和延伸阅读，卡住时知道先查哪一层。',
      '主题分类页增加前置条件、学习重点与按序阅读入口，从分类进入时知道先读哪篇。',
      '搜索页与 404 页标记为不索引，减少无效页面进入搜索结果。',
    ],
  },
  {
    date: '2026-11-14',
    label: '首版本地完成',
    items: [
      '完成首页、学习路线、主题分类、全部教程、搜索、关于与更新日志页面，首版本地构建通过，尚未发布到线上。',
      '建立三条学习路线：Codex 入门、Claude Code 工作流、Agent 到自动化。',
      '加入站内全文搜索（构建时生成索引，浏览器本地匹配）、RSS、站点地图与结构化数据；部署流程与域名配置见 README。',
      '支持深色模式、阅读进度、目录定位与代码块一键复制。',
    ],
  },
];

const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: '更新日志',
    description: 'Zenty AI Guide 的站点与内容更新记录。',
    inLanguage: 'zh-CN',
    url: 'https://aiguide.zenty.top/changelog/',
  },
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title="更新日志"
  description="Zenty AI Guide 的站点功能与教程内容更新记录。"
  jsonLd={jsonLd}
>
  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <header class="page-header">
      <h1 class="page-title">更新日志</h1>
      <p class="page-lead">
        记录结构、路线和教程的实质变化；措辞与排版修订不单独列出。订阅
        <a class="text-link" href="/rss.xml">RSS</a> 可获得新教程。
      </p>
    </header>

    <ol class="change-list mt-8">
      {
        entries.map((entry) => (
          <li class="change-item">
            <div>
              <time class="change-date" datetime={entry.date}>{entry.date}</time>
              <p class="change-label">{entry.label}</p>
            </div>
            <ul class="change-items">
              {entry.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </li>
        ))
      }
    </ol>

    <section class="mt-12 max-w-2xl pb-4">
      <h2 class="text-2xl font-semibold tracking-tight">接下来</h2>
      <p class="mt-3 leading-relaxed text-muted">
        教程按学习路线的顺序补齐，优先完成路线中仍标记为「待发布」的步骤。新增步骤或调整顺序时，会在此处说明原因。
      </p>
    </section>
  </div>
</BaseLayout>