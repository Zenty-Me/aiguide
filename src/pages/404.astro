---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="页面不存在"
  description="请求的页面不存在，可能已移动或尚未发布。"
  noindex
  canonical={false}
>
  <div class="shell">
    <div class="flex min-h-[58vh] flex-col justify-center py-20 md:py-28">
      <p class="meta">404 · 页面不存在</p>
      <h1 class="page-title mt-4">这个页面不存在</h1>
      <p class="page-lead">
        链接可能已过期，或这篇教程还没有发布。可以从下面几处继续。
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn btn--tonal" href="/">回到首页</a>
        <a class="btn btn--line" href="/paths/">学习路线</a>
        <a class="btn btn--line" href="/search/">搜索教程</a>
      </div>
    </div>
  </div>
</BaseLayout>