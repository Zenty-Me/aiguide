---
import BaseLayout from '../layouts/BaseLayout.astro';
import { SITE } from '../consts';
import {
  articleHref,
  byUpdatedDesc,
  categoryGroups,
  formatDate,
  getAllArticles,
  resolvePaths,
  updatedAt,
} from '../lib/articles';
import { categoryHref, categoryName } from '../data/categories';

const articles = await getAllArticles();
const paths = resolvePaths(articles);
const groups = categoryGroups(articles);
const latest = byUpdatedDesc(articles).slice(0, 4);
const firstArticle =
  articles.find((article) => article.id === 'codex-install-login') ??
  articles.find((article) => article.id === 'codex-first-task') ??
  articles[0] ??
  null;

const routeId = (code: string) => code.toLowerCase().replace(/\s+/g, '-');

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  description: SITE.description,
  inLanguage: SITE.locale,
  potentialAction: {
    '@type': 'SearchAction',
    target: `${SITE.url}/search/?q={search_term_string}`,
    'query-input': 'required name=search_term_string',
  },
};
---

<BaseLayout title={SITE.title} description={SITE.description} jsonLd={[jsonLd]}>
  <section class="hero" data-enter>
    <div class="shell">
      <h1 class="display">AI 编程与 Agent 开发指南</h1>

      <div class="hero-lower">
        <div>
          <p class="hero-lead">
            写给中文开发者的 Codex、Claude Code、MCP、Skills 与 Agent 教程。从能跑通的第一步开始，读到可以交给团队的工作流。
          </p>
          <div class="hero-actions">
            {
              firstArticle ? (
                <a class="btn btn--tonal" href={articleHref(firstArticle.id)}>
                  从第一篇教程开始
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              ) : (
                <a class="btn btn--tonal" href="/articles/">
                  浏览全部教程
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              )
            }
            <a class="text-link" href="/paths/">
              浏览学习路线
              <span class="arrow" aria-hidden="true">→</span>
            </a>
          </div>
          <p class="hero-facts">
            <span>{articles.length} 篇教程</span>
            <span>{paths.length} 条路线</span>
            <span>{groups.length} 个主题</span>
          </p>
        </div>

        <div class="recent" aria-labelledby="recent-title">
          <div class="recent-head">
            <p id="recent-title">最近更新</p>
            <a href="/articles/">全部教程 <span class="arrow" aria-hidden="true">→</span></a>
          </div>
          <ul class="recent-list">
            {
              latest.map((article) => (
                <li class="recent-item">
                  <a href={articleHref(article.id)}>
                    <time class="recent-date" datetime={formatDate(updatedAt(article))}>
                      {formatDate(updatedAt(article)).slice(5).replace('-', '/')}
                    </time>
                    <span class="recent-title">{article.data.title}</span>
                    <span class="recent-meta">
                      {categoryName(article.data.category)} · {article.data.difficulty}
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="routes-title">
    <div class="shell">
      <div class="section-head">
        <div>
          <h2 id="routes-title">{paths.length} 条路线，按顺序读</h2>
          <p class="section-intro">
            每条路线从具体任务开始。先选环境，再按相关步骤推进；每一步都留下可检查的结果。
          </p>
        </div>
        <a class="text-link" href="/paths/">
          全部路线
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ol class="path-list">
        {
          paths.map((path, pathIndex) => (
            <li class="path-row">
              <p class="path-index">{String(pathIndex + 1).padStart(2, '0')}</p>
              <div class="path-main">
                <h3>
                  <a href={`/paths/#${routeId(path.code)}`}>{path.title}</a>
                </h3>
                <p class="path-summary">{path.summary}</p>
                <p class="path-actions">
                  <a class="text-link" href={`/paths/#${routeId(path.code)}`}>
                    完整路线 · {path.steps.length} 步
                    <span class="arrow" aria-hidden="true">→</span>
                  </a>
                </p>
              </div>
              <ol class="path-steps">
                {path.steps.slice(0, 3).map((step, stepIndex) =>
                  step.href ? (
                    <li>
                      <a href={step.href}>
                        <span class="step-num" aria-hidden="true">
                          {String(stepIndex + 1).padStart(2, '0')}
                        </span>
                        <span class="step-label">{step.label}</span>
                        <span class="step-meta">
                          {step.category} · {step.difficulty}
                        </span>
                      </a>
                    </li>
                  ) : (
                    <li>
                      <div class="step-static">
                        <span class="step-num" aria-hidden="true">
                          {String(stepIndex + 1).padStart(2, '0')}
                        </span>
                        <span class="step-label">{step.label}</span>
                        <span class="step-meta">待发布</span>
                      </div>
                    </li>
                  ),
                )}
              </ol>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section topics" aria-labelledby="topics-title">
    <div class="shell">
      <div class="section-head">
        <div>
          <h2 id="topics-title">按工具和问题浏览</h2>
          <p class="section-intro">按工具进入，或从手上的问题开始找。</p>
        </div>
        <a class="text-link" href="/categories/">
          全部主题
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>

      <ul class="topic-grid">
        {
          groups.map((group) => (
            <li class="topic-item">
              <a href={categoryHref(group.slug)}>
                <span class="topic-name">{group.name}</span>
                <span class="topic-blurb">{group.blurb}</span>
                <span class="topic-count">{group.articles.length} 篇</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
</BaseLayout>