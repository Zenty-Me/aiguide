---
import type { GetStaticPaths } from 'astro';
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SetupNote from '../../components/SetupNote.astro';
import { SITE } from '../../consts';
import { readingMinutes } from '../../lib/articles';
import { breadcrumbJsonLd, absolute, authorJsonLd } from '../../lib/seo';
import { ogImageFor } from '../../lib/og';

export const getStaticPaths = (async () => {
  const guides = await getCollection('guides');
  return guides
    .sort((a, b) => a.data.order - b.data.order)
    .map((guide) => ({
      params: { slug: guide.id },
      props: { guide },
    }));
}) satisfies GetStaticPaths;

const { guide } = Astro.props;
const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const { Content } = await render(guide);

const { title, description, kicker, updatedAt, faq } = guide.data;
const minutes = readingMinutes(guide.body ?? '');
const isoDate = updatedAt.toISOString();
const ogImage = ogImageFor('guides', guide.id);

const index = guides.findIndex((item) => item.id === guide.id);
const prev = index > 0 ? guides[index - 1] : undefined;
const next = index >= 0 && index < guides.length - 1 ? guides[index + 1] : undefined;

const crumbs = [
  { label: '首页', href: '/' },
  { label: '起步', href: '/start/' },
  { label: title },
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'TechArticle',
    headline: title,
    description,
    inLanguage: SITE.locale,
    datePublished: isoDate,
    dateModified: isoDate,
    author: authorJsonLd,
    publisher: authorJsonLd,
    mainEntityOfPage: absolute(`/start/${guide.id}/`),
    image: absolute(ogImage),
    articleSection: '起步',
    timeRequired: `PT${minutes}M`,
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
  },
  breadcrumbJsonLd(crumbs),
];

if (faq.length > 0) {
  jsonLd.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faq.map((item) => ({
      '@type': 'Question',
      name: item.q,
      acceptedAnswer: { '@type': 'Answer', text: item.a },
    })),
  });
}
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  publishedTime={isoDate}
  modifiedTime={isoDate}
  jsonLd={jsonLd}
>
  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <div class="article-layout">
      <article class="article-body">
        <header class="article-header">
          <div class="article-kicker">
            <a href="/start/">起步</a>
            <span aria-hidden="true">·</span>
            <span>{kicker}</span>
            <span aria-hidden="true">·</span>
            <span>约 {minutes} 分钟</span>
          </div>

          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>

          <div class="article-meta">
            <p>
              作者 <a href="/about/#author">{SITE.author}</a>
              <span aria-hidden="true"> · </span>
              更新于 <time datetime={isoDate.slice(0, 10)}>{isoDate.slice(0, 10)}</time>
            </p>
          </div>
        </header>

        <div class="prose">
          <Content />
        </div>

        {
          faq.length > 0 && (
            <section class="mt-16 border-t border-line pt-8" aria-labelledby="faq-heading">
              <h2 id="faq-heading" class="text-lg font-medium text-ink">
                常见问题
              </h2>
              <div class="mt-6 space-y-6">
                {faq.map((item) => (
                  <div>
                    <h3 class="text-base font-medium leading-relaxed text-ink">{item.q}</h3>
                    <p class="mt-2 max-w-2xl text-sm leading-7 text-muted">{item.a}</p>
                  </div>
                ))}
              </div>
            </section>
          )
        }

        <SetupNote
          slug={guide.id}
          showShop
          title="已经想清楚要哪一种了？"
          body="这里只讲判断标准，不代办任何账号。如果你已经决定要开通，站长自营的渠道在下面；不确定该买哪种，先回到上面那张对照表。"
        />

        <nav class="prev-next" aria-label="上一篇与下一篇">
          {
            prev ? (
              <a href={`/start/${prev.id}/`} rel="prev">
                <span>上一篇</span>
                <span>{prev.data.title}</span>
              </a>
            ) : (
              <span aria-hidden="true" />
            )
          }
          {
            next ? (
              <a href={`/start/${next.id}/`} rel="next">
                <span>下一篇</span>
                <span>{next.data.title}</span>
              </a>
            ) : (
              <span aria-hidden="true" />
            )
          }
        </nav>

        <p class="mt-10">
          <a class="text-link" href="/start/">
            返回「起步」目录
            <span class="arrow" aria-hidden="true">→</span>
          </a>
        </p>
      </article>
    </div>
  </div>
</BaseLayout>
