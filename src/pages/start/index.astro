---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../consts';
import { breadcrumbJsonLd, absolute } from '../../lib/seo';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);

const crumbs = [{ label: '首页', href: '/' }, { label: '起步' }];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: '起步：账号、额度与计费',
    description:
      '在动手之前需要弄清的账务前提：订阅、API Key 与转手账号的区别，月费与 token 费的换算，以及额度窗口撞墙时的表现。',
    inLanguage: SITE.locale,
    url: absolute('/start/'),
    isPartOf: { '@type': 'WebSite', name: SITE.name, url: SITE.url },
    hasPart: guides.map((guide) => ({
      '@type': 'TechArticle',
      headline: guide.data.title,
      url: absolute(`/start/${guide.id}/`),
    })),
  },
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title="起步"
  description="动手之前先弄清账务前提：订阅、API Key 与转手账号的区别，月费与 token 费的换算，以及额度窗口撞墙时的三种表现。"
  jsonLd={jsonLd}
>
  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <header class="page-header">
      <p class="meta">Start here</p>
      <h1 class="page-title">起步：账号、额度与计费</h1>
      <p class="page-lead">
        这里有 {guides.length} 篇。它们不教工具怎么用，只回答动手之前绕不开的那个问题：你手里到底需要哪一种凭据，钱花在哪里，撞墙时会发生什么。
      </p>
    </header>

    <div class="mt-12 grid gap-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-20">
      <div>
        <ol class="m-0 list-none space-y-0 p-0">
          {
            guides.map((guide, index) => (
              <li class="border-t border-line py-8 first:border-t-0 first:pt-0">
                <a class="group block no-underline" href={`/start/${guide.id}/`}>
                  <p class="meta">
                    {String(index + 1).padStart(2, '0')} · {guide.data.kicker}
                  </p>
                  <h2 class="mt-2 text-xl font-medium leading-snug text-ink group-hover:text-brand-strong">
                    {guide.data.title}
                  </h2>
                  <p class="mt-3 max-w-2xl text-base leading-8 text-muted">
                    {guide.data.description}
                  </p>
                  <span class="mt-4 inline-flex items-center gap-2 text-sm text-brand-strong">
                    阅读
                    <span class="arrow" aria-hidden="true">→</span>
                  </span>
                </a>
              </li>
            ))
          }
        </ol>
      </div>

      <aside class="lg:pt-1">
        <div class="border-t border-line-strong pt-4">
          <p class="meta">读它的顺序</p>
          <p class="mt-3 text-sm leading-7 text-muted">
            先读第一篇把凭据类型分清，再决定买月费还是买用量。顺序反了，后面的钱大概率会花重。
          </p>
        </div>
        <div class="mt-8 border-t border-line pt-4">
          <p class="meta">读完之后</p>
          <p class="mt-3 text-sm leading-7 text-muted">
            回到教程，从<strong class="font-medium text-ink">安装与登录</strong>那一篇开始。每篇都假设你已经有可用的凭据。
          </p>
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
