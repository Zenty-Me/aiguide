---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ArticleRow from '../../components/ArticleRow.astro';
import { CATEGORIES, categoryHref } from '../../data/categories';
import { getAllArticles, resolvePaths } from '../../lib/articles';
import { breadcrumbJsonLd, collectionJsonLd } from '../../lib/seo';

export const getStaticPaths = (() =>
  CATEGORIES.map((category) => ({
    params: { category: category.slug },
    props: { category },
  }))) satisfies GetStaticPaths;

const { category } = Astro.props;
const articles = await getAllArticles();
const items = articles.filter((article) => article.data.category === category.slug);
const paths = resolvePaths(articles).filter((path) =>
  path.steps.some((step) => step.category === category.name),
);

const crumbs = [
  { label: '首页', href: '/' },
  { label: '主题分类', href: '/categories/' },
  { label: category.name },
];

const jsonLd = [
  collectionJsonLd({
    name: `${category.name} 教程`,
    description: category.description,
    path: categoryHref(category.slug),
    parts: items.map((article) => ({
      name: article.data.title,
      path: `/articles/${article.id}/`,
    })),
  }),
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title={`${category.name} 教程 — ${category.blurb}`}
  description={category.description}
  jsonLd={jsonLd}
>
  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <header class="page-header">
      <h1 class="page-title">{category.name}</h1>
      <p class="page-lead">{category.description}</p>
      <p class="meta">{items.length} 篇教程</p>
    </header>

    <div class="grid gap-12 pt-10 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <div>
        <section class="category-guide" aria-labelledby="category-guide-heading">
          <h2 id="category-guide-heading">开始之前</h2>
          <p>{category.prerequisites}</p>

          <h2>这个主题要掌握什么</h2>
          <ul>
            {category.focus.map((item) => (
              <li>{item}</li>
            ))}
          </ul>

          {
            items.length > 0 && (
              <p class="category-guide-links">
                按顺序读：
                {items.slice(0, 3).map((article, index) => (
                  <>
                    {index > 0 && <span aria-hidden="true"> · </span>}
                    <a href={`/articles/${article.id}/`}>{article.data.title}</a>
                  </>
                ))}
              </p>
            )
          }
        </section>

        {
          items.length > 0 ? (
            <div class="list-frame">
              {items.map((article) => (
                <ArticleRow article={article} />
              ))}
            </div>
          ) : (
            <div class="notice">
              <p><strong>这个分类的教程还在整理。</strong></p>
              <p>
                可以先沿学习路线阅读相邻主题，或到
                <a class="text-link" href="/paths/">学习路线</a>查看完整顺序。
              </p>
            </div>
          )
        }

        <nav aria-label="其他分类" class="mt-12">
          <div class="list-head">
            <h2>继续浏览</h2>
          </div>
          <ul class="inline-links">
            {
              CATEGORIES.filter((item) => item.slug !== category.slug).map((item) => (
                <li>
                  <a href={categoryHref(item.slug)}>{item.name}</a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>

      <aside class="lg:pt-1">
        <div class="list-head">
          <h2>相关路线</h2>
        </div>
        {
          paths.length > 0 ? (
            <ul class="side-list">
              {paths.map((path) => (
                <li>
                  <a href="/paths/">
                    <span class="side-title">{path.title}</span>
                    <span class="side-meta">
                      {path.steps
                        .filter((step) => step.category === category.name)
                        .map((step) => step.label)
                        .join('；')}
                    </span>
                  </a>
                </li>
              ))}
            </ul>
          ) : (
            <p class="meta pt-4">这类主题暂未编入路线，可单独阅读。</p>
          )
        }
      </aside>
    </div>
  </div>
</BaseLayout>