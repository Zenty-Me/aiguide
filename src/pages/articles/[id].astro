---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import PathRail from '../../components/PathRail.astro';
import SetupNote from '../../components/SetupNote.astro';
import { SITE } from '../../consts';
import {
  getAllArticles,
  articleHref,
  formatDate,
  updatedAt,
  readingMinutes,
  relatedArticles,
  prevNext,
  resolvePaths,
} from '../../lib/articles';
import { categoryName } from '../../data/categories';
import { breadcrumbJsonLd, absolute, authorJsonLd } from '../../lib/seo';
import { ogImageFor } from '../../lib/og';

export const getStaticPaths = (async () => {
  const articles = await getAllArticles();
  return articles.map((article) => ({
    params: { id: article.id },
    props: { article },
  }));
}) satisfies GetStaticPaths;

const { article } = Astro.props;
const articles = await getAllArticles();
const { Content, headings } = await render(article);

const { title, description, category, difficulty, tags, publishedAt } = article.data;
const updated = updatedAt(article);
const ogImage = ogImageFor('articles', article.id);
const minutes = readingMinutes(article.body ?? '');
const related = relatedArticles(article, articles);
const { prev, next } = prevNext(articles, article.id);
const tocItems = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);

const path = resolvePaths(articles).find((item) =>
  item.steps.some((step) => step.id === article.id),
);

const crumbs = [
  { label: '首页', href: '/' },
  { label: categoryName(category), href: `/categories/${category}/` },
  { label: title },
];

const jsonLd: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: title,
    description,
    inLanguage: SITE.locale,
    datePublished: publishedAt.toISOString(),
    dateModified: updated.toISOString(),
    author: authorJsonLd,
    publisher: authorJsonLd,
    mainEntityOfPage: absolute(articleHref(article.id)),
    image: absolute(ogImage),
    articleSection: categoryName(category),
    keywords: tags.join(', '),
    timeRequired: `PT${minutes}M`,
  },
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title={title}
  description={description}
  type="article"
  image={ogImage}
  publishedTime={publishedAt.toISOString()}
  modifiedTime={updated.toISOString()}
  jsonLd={jsonLd}
>
  <div class="progress-track" aria-hidden="true">
    <div class="progress-bar" data-progress-bar></div>
  </div>

  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <div class="article-layout">
      <article class="article-body">
        <header class="article-header">
          <div class="article-kicker">
            <a href={`/categories/${category}/`}>{categoryName(category)}</a>
            <span aria-hidden="true">·</span>
            <span>{difficulty}</span>
            <span aria-hidden="true">·</span>
            <span>约 {minutes} 分钟</span>
          </div>

          <h1 class="article-title">{title}</h1>
          <p class="article-description">{description}</p>

          <div class="article-meta">
            <p>
              作者 <a href="/about/#author">{SITE.author}</a>
              <span aria-hidden="true"> · </span>
              发布于 <time datetime={formatDate(publishedAt)}>{formatDate(publishedAt)}</time>
              {updated.getTime() !== publishedAt.getTime() && (
                <>
                  <span aria-hidden="true"> · </span>
                  更新于 <time datetime={formatDate(updated)}>{formatDate(updated)}</time>
                </>
              )}
            </p>
            {
              tags.length > 0 && (
                <ul class="tags" aria-label="标签">
                  {tags.map((tag) => (
                    <li class="tag">{tag}</li>
                  ))}
                </ul>
              )
            }
          </div>
        </header>

        {
          tocItems.length > 1 && (
            <details class="toc-mobile lg:hidden">
              <summary>本页目录</summary>
              <nav aria-label="本页目录（移动端）" class="toc">
                <ol>
                  {tocItems.map((heading) => (
                    <li class={`depth-${heading.depth}`}>
                      <a href={`#${heading.slug}`}>{heading.text}</a>
                    </li>
                  ))}
                </ol>
              </nav>
            </details>
          )
        }

        <div class="prose">
          <Content />
        </div>

        {article.data.setupNote && <SetupNote slug={article.id} />}

        <footer class="article-footer">
          {
            path && (
              <section class="route-note" aria-labelledby="route-heading">
                <p class="meta">本篇属于</p>
                <h2 id="route-heading">{path.title}</h2>
                <PathRail
                  path={path}
                  variant="compact"
                  currentId={article.id}
                  showMeta={false}
                />
                <a class="text-link" href="/paths/">
                  查看完整路线
                  <span class="arrow" aria-hidden="true">→</span>
                </a>
              </section>
            )
          }

          <nav aria-label="上一篇与下一篇" class="prev-next">
            {
              prev ? (
                <a href={articleHref(prev.id)} rel="prev">
                  <span>上一篇</span>
                  <span>{prev.data.title}</span>
                </a>
              ) : (
                <span aria-hidden="true"></span>
              )
            }
            {
              next ? (
                <a href={articleHref(next.id)} rel="next">
                  <span>下一篇</span>
                  <span>{next.data.title}</span>
                </a>
              ) : (
                <span aria-hidden="true"></span>
              )
            }
          </nav>

          {
            related.length > 0 && (
              <section class="related" aria-labelledby="related-heading">
                <h2 id="related-heading">相关教程</h2>
                <ul>
                  {related.map((item) => (
                    <li>
                      <a href={articleHref(item.id)}>
                        <span class="related-cat">{categoryName(item.data.category)}</span>
                        <span class="related-title">{item.data.title}</span>
                        <span class="related-desc">{item.data.description}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </section>
            )
          }
        </footer>
      </article>

      <TableOfContents
        headings={headings}
        route={path ? { path, currentId: article.id } : undefined}
      />
    </div>
  </div>
</BaseLayout>