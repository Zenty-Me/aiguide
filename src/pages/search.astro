---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { CATEGORIES } from '../data/categories';
import { breadcrumbJsonLd, collectionJsonLd } from '../lib/seo';

const crumbs = [{ label: '首页', href: '/' }, { label: '搜索' }];

const jsonLd = [
  collectionJsonLd({
    name: '搜索教程',
    description: '在 Zenty AI Guide 内搜索中文教程全文。',
    path: '/search/',
  }),
  breadcrumbJsonLd(crumbs),
];
---

<BaseLayout
  title="搜索教程"
  description="搜索 Zenty AI Guide 的全部教程全文：支持中文片段与英文关键词，可按 Codex、Claude Code、Agent、MCP、Skills、自动化筛选。"
  jsonLd={jsonLd}
  noindex
>
  <div class="shell">
    <Breadcrumbs items={crumbs} />

    <header class="page-header">
      <h1 class="page-title">搜索教程</h1>
      <p class="page-lead">
        索引包含全部已发布教程的正文。搜索在你的浏览器里完成，不会把关键词发送到服务器。
      </p>
    </header>

    <form class="search-form" role="search" action="/search/" method="get" data-search-form>
      <label class="sr-only" for="search-q">搜索关键词</label>
      <div class="search-bar">
        <input
          id="search-q"
          class="field"
          type="search"
          name="q"
          placeholder="例如：MCP 权限、代码评审、失败预算"
          autocomplete="off"
          spellcheck="false"
          aria-describedby="search-help"
          data-search-input
        />
        <button class="btn btn--tonal" type="submit">搜索</button>
      </div>
      <p class="form-note" id="search-help">
        中文按片段匹配，英文不区分大小写；多个关键词用空格分隔，结果需同时满足。按
        <kbd>/</kbd> 或 Ctrl / Cmd + K 聚焦搜索框。
      </p>
    </form>

    <fieldset class="filters">
      <legend>按主题筛选</legend>
      {
        CATEGORIES.map((category) => (
          <label class="chip">
            <input type="checkbox" name="category" value={category.slug} />
            {category.name}
          </label>
        ))
      }
    </fieldset>

    <section class="mt-10 max-w-3xl" aria-label="搜索结果">
      <p class="search-status" role="status" aria-live="polite" data-search-status>
        正在载入搜索索引…
      </p>

      <ol class="search-results" data-search-results></ol>

      <div class="notice mt-8" data-search-hint hidden>
        <p><strong>输入关键词开始搜索。</strong></p>
        <p>
          也可以直接浏览<a class="text-link" href="/paths/">学习路线</a>或
          <a class="text-link" href="/categories/">主题分类</a>。
        </p>
      </div>

      <div class="notice mt-8" data-search-empty hidden>
        <p><strong>没有找到匹配的教程。</strong></p>
        <p>
          尝试更短的关键词、减少筛选条件，或换一个近义说法。索引只包含已发布教程，未完成的选题不会出现在结果中。
        </p>
      </div>

      <div class="notice mt-8" data-search-failure hidden>
        <p><strong>搜索索引载入失败。</strong></p>
        <p>
          可能是网络中断或静态文件未部署。可以重试，或直接浏览<a class="text-link" href="/categories/"
            >主题分类</a
          >。
        </p>
        <button class="btn btn--line mt-4" type="button" data-search-retry>重新载入</button>
      </div>

      <noscript>
        <div class="notice mt-8">
          <p><strong>搜索需要启用 JavaScript。</strong></p>
          <p>
            未启用时仍可正常阅读：请使用<a class="text-link" href="/articles/">全部教程</a>或
            <a class="text-link" href="/categories/">主题分类</a>导航。
          </p>
        </div>
      </noscript>
    </section>
  </div>
</BaseLayout>

<script>
  import { initSearch } from '../scripts/search';
  initSearch();
</script>